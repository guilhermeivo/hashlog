# Doxyfile 1.9.8

DOXYFILE_ENCODING      = UTF-8

PROJECT_NAME           = "hashlog"
PROJECT_NUMBER         =
PROJECT_BRIEF          = "Sistema de commits imutáveis em DAG para conversa"

# The maximum height of the logo should not exceed 55 pixels and the maximum 
# width should not exceed 200 pixels.
PROJECT_LOGO           =

OUTPUT_DIRECTORY       = docs/doxygen

OUTPUT_LANGUAGE        = Portuguese

BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = NO

JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES

OPTIMIZE_OUTPUT_FOR_C  = YES

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES


EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_LOCAL_METHODS  = NO

HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

GROUP_NESTED_COMPOUNDS = YES

SORT_MEMBER_DOCS       = YES
SORT_MEMBERS_CTORS_1ST = YES
SORT_GROUP_NAMES       = YES


QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO


INPUT                  = README.md include src
FILE_PATTERNS          = *.c \
                         *.h
RECURSIVE              = YES


EXCLUDE                =

USE_MDFILE_AS_MAINPAGE = README.md

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

HTML_OUTPUT            = html

HAVE_DOT               = YES
COLLABORATION_GRAPH    = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
DOT_GRAPH_MAX_NODES    = 50
